# ============================================================
# اتحاد / رهیار — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values from your
# Supabase project dashboard (Settings → API).
#
# NEVER commit real secrets.
# NEVER put the service_role key in NEXT_PUBLIC_ variables.
# ============================================================

# Supabase (required for multi-tenant features)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: only used on the server (e.g. admin scripts, migrations)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Future: AI provider (must be called from server routes only)
# AI_PROVIDER=
# AI_API_KEY=
